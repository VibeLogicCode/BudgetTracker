# Copy this file to `.env` next to synology-compose-pull.yml (the same folder as the compose
# file) and fill in the value. The value is empty on purpose: an empty token stops the project
# from starting, so a copied example can never become a token shared between installs.
#
# Use a long random value, for example the output of: openssl rand -hex 32
# It is used as both WATCHTOWER_TOKEN (the app) and WATCHTOWER_HTTP_API_TOKEN (watchtower).
WATCHTOWER_TOKEN=
