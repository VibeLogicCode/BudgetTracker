node_modules
.next
.git
.tmp-data
data
docs
coverage
*.db
*.db-wal
*.db-shm
.env
.env.local

# Gitignored local scratch space for real bank CSVs (see .gitignore) -- never committed, but a
# LOCAL docker build traces the project tree (Turbopack standalone, see below) and would copy
# real statements into the image if this were left off. CI builds from a clean checkout so
# nothing has leaked publicly, but a local build must not be able to.
real-statements/

# Next 16 (Turbopack) traces output: 'standalone' far more inclusively than Next 15 did: it
# copies the project tree rather than only the files output-file-tracing identified. The
# Dockerfile then does `COPY /app/.next/standalone ./`, so anything left in the build context
# ends up in the SHIPPED IMAGE. Verified on the 16.3.2 upgrade: a local build put .git (25 MB),
# docs/, tests/ and .superpowers/ inside .next/standalone/.
#
# .git, docs and .tmp-data were already excluded above, so those never reached the builder. The
# four below were not, and .superpowers is the one that actually matters: it is GITIGNORED
# working notes, and this image is PUBLIC on GHCR. tests/ is 3 MB of dead weight in a runtime
# image. Neither is needed to build or run.
#
# tests/ops/docker.test.ts asserts these stay excluded, so the leak cannot come back quietly.
.superpowers
tests
.github
install

# O-02 (2026-09-02 review, P1). Everything below was reaching the build context, and therefore
# `COPY . .` and Next's standalone tracing, purely because nothing named it. tests/ops/docker.test.ts
# now enumerates the repo root and fails on any entry that is neither ignored here nor on its
# REQUIRED_IN_BUILD_CONTEXT allowlist, so a NEW directory can no longer ship by default -- which is
# the actual fix. These entries are the backlog that guard found on its first run.

# Local tooling and editor state. .claude carries agent configuration; this image is public.
.claude
.vscode

# A third-party design prototype with its own lockfile. .gitignore calls it "Never shipped,
# never published" -- which was true of git and not of Docker.
UI Component/

# Development inputs, verified not read at runtime: nothing in src/ or scripts/ opens either
# directory (the @/lib/packs hits are a source module, not this folder).
packs/
fixtures/

# Build caches and repo metadata: large, useless in an image, and tsbuildinfo is ~350 KB.
*.tsbuildinfo
.gitignore
.gitattributes

# Documentation and compose/config files that the running container never reads. INSTALL.md and
# README.md are for people looking at the repository, not the image. CHANGELOG.md is deliberately
# NOT here -- Settings -> About renders it at runtime.
README.md
INSTALL.md
docker-compose.yml
drizzle.config.ts
vitest.config.ts
.env.example

# Screen recordings dropped in the repo root while demoing. Gitignored, but .gitignore has never
# had any bearing on what Docker sends -- which is this whole section's point.
screen-*.mp4
